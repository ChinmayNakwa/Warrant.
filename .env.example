# Copy to .env and adjust. Every variable is optional.

WARRANT_DATABASE_URL=sqlite:///./data/warrant.db

# Generate a real secret for anything shared:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
WARRANT_JWT_SECRET=dev-insecure-secret-change-me
WARRANT_ACCESS_TOKEN_TTL_SECONDS=900
WARRANT_REFRESH_TOKEN_TTL_SECONDS=1209600
WARRANT_BCRYPT_ROUNDS=12
WARRANT_RATE_LIMIT_WINDOW_SECONDS=300
WARRANT_RATE_LIMIT_MAX_ATTEMPTS=10
# Set to true when serving over HTTPS
WARRANT_COOKIE_SECURE=false
# Where the frontend runs; comma-separated if there are several
WARRANT_FRONTEND_ORIGIN=http://localhost:3000

# The model, served by Ollama. With no model set, runs answer 503.
# Local: install Ollama from ollama.com, then `ollama pull qwen3:4b`.
# WARRANT_OLLAMA_MODEL=qwen3:4b
# WARRANT_OLLAMA_BASE_URL=http://localhost:11434
#
# Hosted: create a key at ollama.com and use a model name its API lists.
# Telemetry leaves this machine on this path.
# WARRANT_OLLAMA_MODEL=gpt-oss:120b
# WARRANT_OLLAMA_BASE_URL=https://ollama.com
# WARRANT_OLLAMA_API_KEY=

# How much telemetry the model reads for one incident
# WARRANT_MAX_SLICE_EVENTS=120
# WARRANT_SLICE_WINDOW_SECONDS=120
# If the server is killed mid-run, the incident accepts a new run after this long
# WARRANT_RUN_CLAIM_TTL_SECONDS=900
