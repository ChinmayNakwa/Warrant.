# Copy to .env and adjust. Every variable is optional.

WARRANT_DATABASE_URL=sqlite:///./data/warrant.db

# Generate a real secret for anything shared:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
WARRANT_JWT_SECRET=dev-insecure-secret-change-me
WARRANT_ACCESS_TOKEN_TTL_SECONDS=900
WARRANT_REFRESH_TOKEN_TTL_SECONDS=1209600
WARRANT_BCRYPT_ROUNDS=12
WARRANT_RATE_LIMIT_WINDOW_SECONDS=300
WARRANT_RATE_LIMIT_MAX_ATTEMPTS=10
# Set to true when serving over HTTPS
WARRANT_COOKIE_SECURE=false
# Where the frontend runs; comma-separated if there are several
WARRANT_FRONTEND_ORIGIN=http://localhost:3000
